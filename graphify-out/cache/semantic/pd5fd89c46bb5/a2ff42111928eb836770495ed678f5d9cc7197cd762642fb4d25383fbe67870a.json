rce_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_xlsxrenderer", "label": "XLSXRenderer (xlsx)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_i18nrenderer", "label": "I18nRenderer (i18n)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exporteert vertaalbare velden naar JSON-i18n en kan ze direct vertalen via twee inwisselbare backends."}, {"id": "docs_technisch_componenten_renderers_jinja2renderer", "label": "Jinja2Renderer (jinja2)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_ggm_mdrenderer", "label": "GGM_MDRenderer (ggm_md)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_json_schemarenderer", "label": "JSON_SchemaRenderer (json_schema)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_ttlrenderer", "label": "TTLRenderer (ttl)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_rdfrenderer", "label": "RDFRenderer (rdf)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_jsonldrenderer", "label": "JSONLDRenderer (jsonld)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_sqlarenderer", "label": "SQLARenderer (sqla)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_earepoupdater", "label": "EARepoUpdater (ea_repo)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directe ODBC-toegang tot EA-databases; destructieve operaties zitten achter --ea_allow_insert/--ea_allow_delete. Schrijft ook diagramlayout terug naar t_diagramobjects/t_diagramlinks met dezelfde (omgekeerde) coordinaatconversies als de qea-parser. Rijen van elementtypen die crunch_uml niet beheert (Notes, packages) blijven onaangeroerd, zodat een partiele export geen layout sloopt waar hij niets van weet."}, {"id": "docs_technisch_componenten_renderers_schemadiffmarkdownrenderer", "label": "SchemaDiffMarkdownRenderer (schema_diff_md)", "file_type": "concept", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_componenten_renderers_translate_data_pipeline", "label": "translate_data \u2014 drie-passes vertaalpijplijn", "file_type": "rationale", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verzamel unieke strings (met hergebruik uit original_i18n), vertaal parallel met ThreadPoolExecutor(max_workers=8) omdat de GIL vrijkomt tijdens HTTP-calls, en herbouw daarna de structuur uit de dedup-cache. Effect: ~500 unieke strings in 1-2 minuten in plaats van 10+ minuten."}, {"id": "docs_technisch_componenten_renderers_ollama_backend", "label": "Ollama vertaal-backend", "file_type": "rationale", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lokaal LLM (Mistral) via Ollama; trager per call dan de translators-library maar sterk op domeinjargon en behoudt casing. Drie deterministische beschermingslagen rond de LLM-call: opaque-token preserve-filter, num_predict cap (4x input + 128, max 2048) tegen runaway-generatie, en reconcile_case als vangnet."}, {"id": "docs_technisch_componenten_renderers_opaque_token_preserve_filter", "label": "Opaque-token preserve-filter", "file_type": "rationale", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "XML-tags, EAID-identifiers, URLs, ISO-datums en pure punctuatie worden zonder LLM-call verbatim teruggegeven om hallucinatie rondom <memo> en GUIDs te voorkomen."}, {"id": "docs_technisch_componenten_renderers_reconcile_case", "label": "reconcile_case safety net", "file_type": "rationale", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Als de bron een camelCase/PascalCase/snake_case/kebab-case/ALL_CAPS identifier is en het LLM-resultaat spaties bevat, splitst de helper de output en herstelt deterministisch de bron-casing."}, {"id": "docs_technisch_componenten_renderers_fallback_keten", "label": "Vertaal-fallbackketen", "file_type": "rationale", "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ollama faalt (RequestException) naar de translators-library, die na drie mislukte pogingen de brontekst behoudt. Een ontbrekende Ollama-server breekt daardoor nooit een pijplijn."}], "edges": [{"source": "docs_technisch_componenten_renderers_modelrenderer", "target": "docs_technisch_componenten_renderers_renderer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_componenten_renderers_jsonrenderer", "target": "docs_technisch_componenten_renderers_renderer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_componenten_renderers_csvrenderer", "target": "docs_technisch_componenten_renderers_renderer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_componenten_renderers_i18nrenderer", "target": "docs_technisch_componenten_renderers_renderer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_componenten_renderers_xlsxrenderer", "target": "docs_technisch_componenten_renderers_renderer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/componenten/renderers.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_componenten_renderers_jinja