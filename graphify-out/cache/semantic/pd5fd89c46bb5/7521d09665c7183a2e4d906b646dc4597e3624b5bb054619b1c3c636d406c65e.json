{"nodes": [{"id": "docs_technisch_componenten_persistentie_persistentielaag", "label": "Persistentielaag (pagina)", "file_type": "document", "source_file": "docs/technisch/componenten/persistentie.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Het hart van crunch_uml: een gestandaardiseerd metaschema opgeslagen via SQLAlchemy ORM met multi-versie ondersteuning."}, {"id": "docs_technisch_componenten_persistentie_database", "label": "Database klasse (db.py)", "file_type": "concept", "source_file": "docs/technisch/componenten/persistentie.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singleton-implementatie die een actieve verbinding per proces garandeert; default sqlite:///crunch_uml.db."}, {"id": "docs_technisch_componenten_persistentie_schema", "label": "Schema klasse (schema.py)", "file_type": "concept", "source_file": "docs/technisch/componenten/persistentie.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper rondom een logisch schema die alle CRUD-operaties automatisch op schema_id filtert, waardoor multi-versie modellen in een database mogelijk zijn."}, {"id": "docs_technisch_componenten_persistentie_junction_tables", "label": "Diagram junction tables (membership + layout)", "file_type": "concept", "source_file": "docs/technisch/componenten/persistentie.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "diagram_class, diagram_enumeration, diagram_association en diagram_generalization dragen naast membership ook nullable geometriekolommen in het canonieke coordinatenstelsel."}, {"id": "docs_technisch_componenten_persistentie_datamodelversie_migratie", "label": "Datamodelversie en migratie (crunch_uml_meta)", "file_type": "rationale", "source_file": "docs/technisch/comp