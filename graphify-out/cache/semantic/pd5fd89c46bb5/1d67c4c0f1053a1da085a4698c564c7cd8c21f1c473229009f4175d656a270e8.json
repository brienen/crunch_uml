{"nodes": [{"id": "docs_technisch_architectuur_design_patterns_design_patterns", "label": "Design Patterns (pagina)", "file_type": "document", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_technisch_architectuur_design_patterns_registry_pattern", "label": "Registry Pattern", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Het centrale pattern van crunch_uml. Voordeel: nieuwe implementaties toevoegen zonder bestaande code aan te passen \u2014 alleen een @register decorator nodig."}, {"id": "docs_technisch_architectuur_design_patterns_singleton_pattern", "label": "Singleton Pattern (Database._instance)", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Garandeert een actieve databaseverbinding per proces via een _instance class variable en __new__. Erkend nadeel: problematisch bij multi-threaded of concurrent gebruik \u2014 opgenomen als kwetsbaarheid."}, {"id": "docs_technisch_architectuur_design_patterns_mixin_pattern", "label": "Mixin Pattern (UML_Generic / UMLBase / UMLTags*)", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Herbruikbare velddefinities worden gecomponeerd via mixins om duplicatie over de ORM-modellen te voorkomen."}, {"id": "docs_technisch_architectuur_design_patterns_two_phase_parsing", "label": "Two-Phase Parsing", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fase 1 creeert alle entiteiten, fase 2 legt relaties aan. Nodig omdat XMI-bestanden relaties kunnen definieren voordat de gerelateerde entiteiten in het document voorkomen (forward references)."}, {"id": "docs_technisch_architectuur_design_patterns_template_method_pattern", "label": "Template Method Pattern", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parser-, Renderer- en Transformer-baseklassen definieren de interface (abstractmethod); subklassen implementeren de specifieke logica, gedeelde logica leeft in tussenklassen zoals ModelRenderer."}, {"id": "docs_technisch_architectuur_design_patterns_decorator_pattern", "label": "Decorator Pattern (@register)", "file_type": "rationale", "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combineert klasse-registratie met de Registry, zodat een nieuwe parser slechts drie stappen kost: klasse aanmaken, decorator toevoegen, parse() implementeren."}], "edges": [{"source": "docs_technisch_architectuur_design_patterns_design_patterns", "target": "docs_technisch_architectuur_design_patterns_registry_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_architectuur_design_patterns_design_patterns", "target": "docs_technisch_architectuur_design_patterns_singleton_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/technisch/architectuur/design-patterns.md", "source_location": null, "weight": 1.0}, {"source": "docs_technisch_architectuur_desi